{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012Shm5nSM1TCYrpniRRpC3Z","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport sys\n4\timport time\n5\timport unittest\n6\tfrom concurrent.futures import ThreadPoolExecutor\n7\tfrom pathlib import Path\n8\tfrom threading import Lock\n9\t\n10\tsys.path.insert(0, str(Path(__file__).resolve().parents[1]))\n11\tfrom src.idempotency import IdempotencyExecutor\n12\t\n13\t\n14\tclass IdempotencyExecutorTest(unittest.TestCase):\n15\t    def test_concurrent_same_key_runs_operation_once(self) -> None:\n16\t        executor = IdempotencyExecutor()\n17\t        calls = 0\n18\t        lock = Lock()\n19\t\n20\t        def operation() -> str:\n21\t            nonlocal calls\n22\t            time.sleep(0.02)\n23\t            with lock:\n24\t                calls += 1\n25\t            return \"ok\"\n26\t\n27\t        with ThreadPoolExecutor(max_workers=20) as pool:\n28\t            results = list(pool.map(lambda _: executor.execute(\"same\", operation), range(50)))\n29\t        self.assertEqual([\"ok\"] * 50, results)\n30\t        self.assertEqual(1, calls)\n31\t\n32\t    def test_failed_operation_is_not_cached(self) -> None:\n33\t        executor = IdempotencyExecutor()\n34\t        attempts = 0\n35\t\n36\t        def operation() -> str:\n37\t            nonlocal attempts\n38\t            attempts += 1\n39\t            if attempts == 1:\n40\t                raise RuntimeError(\"temporary\")\n41\t            return \"ok\"\n42\t\n43\t        with self.assertRaises(RuntimeError):\n44\t            executor.execute(\"retry\", operation)\n45\t        self.assertEqual(\"ok\", executor.execute(\"retry\", operation))\n46\t        self.assertEqual(2, attempts)\n47\t\n48\t\n49\tif __name__ == \"__main__\":\n50\t    unittest.main()\n51\t"}]},"parent_tool_use_id":null,"session_id":"7da63874-d135-4224-8b98-128243e1c3e6","uuid":"2c7fd74b-bb60-425a-a067-ef7b3c237d5e","timestamp":"2026-07-21T12:16:05.444Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/hb/3xs5_1_x2jb5wy_x9yy657wc0000gp/T/proofloop-normal-live-53guo7_w/workspace/tests/test_idempotency.py","content":"from __future__ import annotations\n\nimport sys\nimport time\nimport unittest\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom threading import Lock\n\nsys.path.insert(0, str(Path(__file__).resolve().parents[1]))\nfrom src.idempotency import IdempotencyExecutor\n\n\nclass IdempotencyExecutorTest(unittest.TestCase):\n    def test_concurrent_same_key_runs_operation_once(self) -> None:\n        executor = IdempotencyExecutor()\n        calls = 0\n        lock = Lock()\n\n        def operation() -> str:\n            nonlocal calls\n            time.sleep(0.02)\n            with lock:\n                calls += 1\n            return \"ok\"\n\n        with ThreadPoolExecutor(max_workers=20) as pool:\n            results = list(pool.map(lambda _: executor.execute(\"same\", operation), range(50)))\n        self.assertEqual([\"ok\"] * 50, results)\n        self.assertEqual(1, calls)\n\n    def test_failed_operation_is_not_cached(self) -> None:\n        executor = IdempotencyExecutor()\n        attempts = 0\n\n        def operation() -> str:\n            nonlocal attempts\n            attempts += 1\n            if attempts == 1:\n                raise RuntimeError(\"temporary\")\n            return \"ok\"\n\n        with self.assertRaises(RuntimeError):\n            executor.execute(\"retry\", operation)\n        self.assertEqual(\"ok\", executor.execute(\"retry\", operation))\n        self.assertEqual(2, attempts)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","numLines":51,"startLine":1,"totalLines":51}}}
